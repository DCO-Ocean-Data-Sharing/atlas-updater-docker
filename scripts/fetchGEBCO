
# FETCHGEBCO - checks the GEBCO Latest shaded-relief WMS for the UN Ocean Decade's Global Digital Atlas
# The layer connects directly to GEBCO's WMS
# data download is required.
# :date: 2026-10-14
# :version: 1.0.0

import urllib.request
import urllib.error
import xml.etree.ElementTree as ET
import sys

gebcoURL = (
    "https://wms.gebco.net/mapserv?"
    "SERVICE=WMS&VERSION=1.3.0&REQUEST=GetCapabilities"
)

try:
    with urllib.request.urlopen(gebcoURL, timeout=60) as resp:
        root = ET.fromstring(resp.read())

    if root.tag.split("}")[-1] not in (
        "WMS_Capabilities", "WMT_MS_Capabilities"
    ):
        raise ValueError("Invalid WMS capabilities response")

    layers = [
        element.text.strip()
        for element in root.iter()
        if element.tag.split("}")[-1] == "Name" and element.text
    ]

    if "GEBCO_LATEST" in layers:
        print("GEBCO shaded-relief new WMS is available.")
        print("The Atlas uses the latest imagery provided by GEBCO.")
    else:
        raise ValueError("GEBCO_LATEST layer not found")

except (urllib.error.URLError, ET.ParseError, ValueError) as e:
    print(f"GEBCO WMS check failed: {e}", file=sys.stderr)
    sys.exit(1)
